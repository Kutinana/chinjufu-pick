{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "exit 0",
  "outputDirectory": "vercel-redirect-public",
  "redirects": [
    {
      "source": "/",
      "destination": "https://chinjufu-pick.pages.dev/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://chinjufu-pick.pages.dev/:path*",
      "permanent": true
    }
  ]
}
